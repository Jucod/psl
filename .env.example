# Base
DATABASE_URL=postgres://psl:psl@127.0.0.1:5432/psl

# Embeddings. "local" ne demande aucune cle et fonctionne hors ligne.
# Bascule sur "openai" ou "mistral" quand tu veux les vrais vecteurs.
PSL_EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Couche LLM. "local" = parseur deterministe + formulation par gabarit, zero appel reseau.
PSL_LLM_PROVIDER=local
ANTHROPIC_API_KEY=
PSL_LLM_MODELE=claude-sonnet-5

# Garde-fous budget (section 7 du brief)
PSL_MAX_LONGUEUR_MESSAGE=400
PSL_RATE_LIMIT_PAR_IP_PAR_HEURE=20
PSL_PLAFOND_EUR_PAR_JOUR=2.00
PSL_IP_HASH_SECRET=change-moi-en-prod

# Autorise les cuvees dont la note vient d'une fixture de developpement.
# Depuis le relevee du 16/09/2026, 15 cuvees sur 17 sont reelles: la demo
# tourne a 0. Seules les deux Lancyre restent sur calque, masquees champ par
# champ. Ne passe a 1 que pour travailler sur elles, JAMAIS en demo publique
# (le serveur log un bandeau si 1). La suite de tests force 1 de son cote.
PSL_AUTORISER_FIXTURES=0

PORT=3000
