# Database
DATABASE_URL=postgres://psl:psl@127.0.0.1:5432/psl

# Embeddings. "local" needs no key and works offline.
# Switch to "openai" or "mistral" when you want real vectors.
PSL_EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
MISTRAL_API_KEY=

# LLM layer. "local" = deterministic parser + template formulation, zero network calls.
# "anthropic" needs an API key from https://console.anthropic.com (billed per
# use, separately from a Claude Pro/Max subscription, which does not cover it).
PSL_LLM_PROVIDER=local
ANTHROPIC_API_KEY=
# claude-opus-5-5 by default; claude-sonnet-5-5 halves the cost per search.
PSL_LLM_MODEL=claude-opus-5-5

# Spending guardrails (section 7 of the brief)
PSL_MAX_MESSAGE_LENGTH=400
PSL_RATE_LIMIT_PER_IP_PER_HOUR=20
PSL_DAILY_BUDGET_EUR=2.00
PSL_IP_HASH_SECRET=change-me-in-production

# Comma-separated origins allowed to call the API from a browser.
# Empty = same origin only.
PSL_ALLOWED_ORIGINS=

# Allows wines whose note comes from a development fixture.
# Since the 16/09/2026 data collection, 15 wines out of 17 are real: the demo
# runs with 0. Only the two Lancyre wines remain on the overlay, masked field
# by field. Set it to 1 only to work on them, NEVER on a public demo (the
# server logs a banner when it is 1). The test suite forces 1 on its side.
PSL_ALLOW_FIXTURES=0

# npm run collect: e-mail or URL sent in the user-agent to the estates' websites.
PSL_COLLECT_CONTACT=

PORT=3000
