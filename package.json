{
  "name": "psl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Conversational search engine over a product catalog. Demo: the Pic Saint-Loup AOC.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npm run db:migrate && npm run db:seed && npm run db:embed",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:seed": "tsx src/cli/seed.ts",
    "db:embed": "tsx src/cli/embed.ts",
    "db:reset": "tsx src/cli/migrate.ts --reset",
    "schema:export": "tsx src/cli/export-schema.ts",
    "demo": "tsx src/cli/demo.ts",
    "api": "tsx src/api/server.ts",
    "api:dev": "tsx watch src/api/server.ts",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^10.1.5",
    "fastify": "^5.12.5",
    "pg": "^8.13.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  }
}
