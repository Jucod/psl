{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "appellation": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ],
      "description": "Appellation identifier, e.g. aoc-pic-saint-loup. null if not specified."
    },
    "color": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "red",
            "rose",
            "white"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "red, rose or white. null if not specified."
    },
    "price_min": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        {
          "type": "null"
        }
      ],
      "description": "Minimum budget in euros, VAT included. null if not specified."
    },
    "price_max": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        {
          "type": "null"
        }
      ],
      "description": "Maximum budget in euros, VAT included. null if not specified."
    },
    "vintage_min": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        {
          "type": "null"
        }
      ]
    },
    "vintage_max": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        {
          "type": "null"
        }
      ]
    },
    "organic": {
      "description": "true if the user explicitly asks for organic wine. null otherwise.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "grapes_included": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 60
      },
      "description": "Wanted grape varieties. Empty array if not specified."
    },
    "grapes_excluded": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 60
      },
      "description": "Rejected grape varieties. Empty array if not specified."
    },
    "dish": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "lamb",
            "beef",
            "game",
            "stew",
            "poultry",
            "charcuterie",
            "cheese",
            "fish",
            "aperitif"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "Closed vocabulary. null if no dish in the list matches."
    },
    "descriptors": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 40
      },
      "description": "Wanted sensory descriptors. Used for ranking, never displayed."
    },
    "descriptors_excluded": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 40
      },
      "description": "REJECTED sensory descriptors. \"pas trop tannique\" puts \"supple\" in descriptors AND \"tannic\" here. Used for ranking, never displayed."
    }
  },
  "required": [
    "appellation",
    "color",
    "price_min",
    "price_max",
    "vintage_min",
    "vintage_max",
    "organic",
    "grapes_included",
    "grapes_excluded",
    "dish",
    "descriptors",
    "descriptors_excluded"
  ],
  "additionalProperties": false,
  "x-invariants": [
    "price_min <= price_max",
    "vintage_min <= vintage_max"
  ]
}
