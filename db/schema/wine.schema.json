{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "producer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "appellation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "color": {
      "type": "string",
      "enum": [
        "red",
        "rose",
        "white"
      ]
    },
    "vintage": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        {
          "type": "null"
        }
      ]
    },
    "blend": {
      "default": [],
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "grape": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "pct": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "grape",
          "pct"
        ],
        "additionalProperties": false
      }
    },
    "abv": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        {
          "type": "null"
        }
      ]
    },
    "aging": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    },
    "price_eur": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        {
          "type": "null"
        }
      ]
    },
    "price_as_of": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "organic": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "certification": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 60
        },
        {
          "type": "null"
        }
      ]
    },
    "tasting_note": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4000
        },
        {
          "type": "null"
        }
      ]
    },
    "tasting_note_source": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "type": {
              "type": "string",
              "enum": [
                "specification",
                "tech_sheet",
                "directory",
                "producer_page",
                "dev_fixture"
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "url": {
              "type": "string",
              "maxLength": 500,
              "format": "uri"
            },
            "authority": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 120
                },
                {
                  "type": "null"
                }
              ]
            },
            "retrieved_on": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "content_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 64,
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "type",
            "label",
            "url",
            "retrieved_on"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "producer_pairings": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 120
      }
    },
    "page_url": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 500,
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "producer_id",
    "appellation_id",
    "name",
    "color",
    "vintage",
    "abv",
    "aging",
    "price_eur",
    "price_as_of",
    "organic",
    "certification",
    "tasting_note",
    "tasting_note_source",
    "page_url"
  ],
  "additionalProperties": false,
  "x-invariants": [
    "a non-null tasting_note implies a non-null tasting_note_source",
    "a non-null price_eur implies a non-null price_as_of",
    "blend percentages add up to 0 (not provided) or ~100"
  ]
}
