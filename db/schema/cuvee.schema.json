{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "domaine_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "appellation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "nom_cuvee": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "couleur": {
      "type": "string",
      "enum": [
        "rouge",
        "rose",
        "blanc"
      ]
    },
    "millesime": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        {
          "type": "null"
        }
      ]
    },
    "assemblage": {
      "default": [],
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cepage": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "pct": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "cepage",
          "pct"
        ],
        "additionalProperties": false
      }
    },
    "degre": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        {
          "type": "null"
        }
      ]
    },
    "elevage": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    },
    "prix_ttc": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        {
          "type": "null"
        }
      ]
    },
    "prix_date_releve": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "bio": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "certification": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 60
        },
        {
          "type": "null"
        }
      ]
    },
    "note_degustation": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4000
        },
        {
          "type": "null"
        }
      ]
    },
    "note_degustation_source": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "type": {
              "type": "string",
              "enum": [
                "cahier_des_charges",
                "fiche_technique",
                "annuaire",
                "page_domaine",
                "fixture_dev"
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "url": {
              "type": "string",
              "maxLength": 500,
              "format": "uri"
            },
            "autorite": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 120
                },
                {
                  "type": "null"
                }
              ]
            },
            "date_releve": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "contenu_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 64,
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "type",
            "label",
            "url",
            "date_releve"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "accords_producteur": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 120
      }
    },
    "fiche_url": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 500,
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "domaine_id",
    "appellation_id",
    "nom_cuvee",
    "couleur",
    "millesime",
    "degre",
    "elevage",
    "prix_ttc",
    "prix_date_releve",
    "bio",
    "certification",
    "note_degustation",
    "note_degustation_source",
    "fiche_url"
  ],
  "additionalProperties": false,
  "x-invariants": [
    "note_degustation non null implique note_degustation_source non null",
    "prix_ttc non null implique prix_date_releve non null",
    "les pourcentages d assemblage totalisent 0 (non renseignes) ou ~100"
  ]
}
