  "wine_schema": {
    "_usage": "target shape of a product row. Nothing here is pre-filled: every field comes from the estate's tech sheet.",
    "id": "string",
    "producer_id": "string",
    "name": "string",
    "appellation_id": "string",
    "color": "red | rose",
    "vintage": "integer",
    "blend": [
      {
        "grape": "string",
        "pct": "number | null"
      }
    ],
    "abv": "number | null",
    "aging": "string | null",
    "price_eur": "number | null",
    "price_as_of": "date | null",
    "organic": "boolean | null",
    "producer_tasting_note": "string | null",
    "tasting_note_source_url": "string | null",
    "producer_pairings": [
      "string"
    ],
    "embedding_text": "concatenation of producer_tasting_note + appellation profile",
    "_constraint": "if producer_tasting_note is null, the agent answers from the appellation profile and says so. It never fills the gap."
  },
  "ingestion_plan": [
    "1. Parse the syndicate directory (one page) to get the name, commune and URL of each estate.",
    "2. For each website, locate the PDF tech sheets (often /nos-vins, /la-cave, trade area).",
    "3. Extract text + tables, produce a JSON matching wine_schema, versioned in git.",
    "4. Review the first batch by hand. The parsing error rate is the metric to measure; it is what you will show the client.",
    "5. Index: structured fields as Postgres columns, embedding_text in pgvector.",
    "6. Honor robots.txt, rate-limit, identify the user-agent. Tech sheets are public but remain the estate's property: cite the source in the UI, do not republish the full text."
  ]
}